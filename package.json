{
  "name": "stillwiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:packages": "npm run build -w @stillwiki/core",
    "predev": "npm run build:packages",
    "dev": "vite",
    "prebuild": "npm run build:packages",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env.local server/index.ts",
    "server:dev": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "db:migrate": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/migrations.sql -c \"notify pgrst, 'reload schema';\"",
    "db:seed": "psql \"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f supabase/seed.sql",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "i18n:pull": "node --env-file-if-exists=.env.local scripts/i18n-pull.mjs",
    "i18n:push": "node --env-file-if-exists=.env.local scripts/i18n-push.mjs",
    "test": "vitest run",
    "pretypecheck": "npm run build:packages",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stillwiki/core": "*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "@uiw/react-markdown-preview": "5.2.1",
    "@uiw/react-md-editor": "4.1.2",
    "cors": "2.8.6",
    "express": "5.2.1",
    "gray-matter": "4.0.3",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "jszip": "3.10.2",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-icons": "5.7.0",
    "react-router-dom": "7.18.4",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
